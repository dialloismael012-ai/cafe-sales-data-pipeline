      <aliases enabled='yes' />
      <column caption='Panier' datatype='string' name='[Calculation_0382696466251776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [total_spent] &lt; 10 THEN &apos;Petit&apos;&#13;&#10;ELSEIF [total_spent] &lt; 20 THEN &apos;Moyen&apos;&#13;&#10;ELSEIF [total_spent] &gt;= 20 THEN &apos;Grand&apos;&#13;&#10;END' />
      </column>
      <column caption='% Item' datatype='real' name='[Calculation_0382696472104961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [item]=&apos;Unknown&apos; THEN 1 ELSE 0 END )/ COUNT([transaction_id])' />
      </column>
      <column caption='% Paiement' datatype='real' name='[Calculation_0382696473784322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [payment_method] = &apos;Unknown&apos; THEN 1 ELSE 0 END) / COUNT([transaction_id])' />
      </column>
      <column caption='% Date' datatype='real' name='[Calculation_0382696474796035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF ISNULL([transaction_date]) THEN 1 ELSE 0 END) / COUNT([transaction_id])' />
      </column>
      <column caption='% Lieu' datatype='real' name='[Calculation_0382696475770884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [location] = &apos;Unknown&apos; THEN 1 ELSE 0 END)/ COUNT([transaction_id])' />
      </column>
